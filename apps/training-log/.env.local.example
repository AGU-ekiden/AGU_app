# --- Notion (日誌の保存先) ---
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 練習日誌DB(新規作成。プロパティ定義は README.md 参照)
NOTION_TRAINING_LOG_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 部員マスタDB(tiryou-karteと同じDB。任意。設定すると日誌に「部員」relationを紐付ける)
NOTION_MEMBERS_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Supabase (選手マスタ・Stravaトークン保管) ---
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
# service_role キー(サーバー側APIルートのみで使用。ブラウザに渡さない)
SUPABASE_SERVICE_ROLE_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Strava API (https://www.strava.com/settings/api で発行) ---
STRAVA_CLIENT_ID=xxxxxxx
STRAVA_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Strava側の「Authorization Callback Domain」に登録したドメイン込みの絶対URL
# (例: https://<ポータルのドメイン>/training-log/api/strava/callback)
STRAVA_REDIRECT_URI=https://example.vercel.app/training-log/api/strava/callback
