# ============================================================
# Dropbox API 連携設定
# ============================================================
# このファイルをコピーして `.env.local` を作成し、値を設定してください。
#   cp .env.example .env.local
# `.env.local` は .gitignore 済みのため、コミットされません。

# ------------------------------------------------------------
# 【推奨】OAuth 2.0 リフレッシュトークン方式
# ------------------------------------------------------------
# アクセストークンは数時間で失効するため、本番運用ではこちらを推奨します。
# 1. https://www.dropbox.com/developers/apps で「Scoped access」アプリを作成
# 2. Permissions タブで files.metadata.read と files.content.read を有効化
# 3. OAuth2 Authorization Code フロー（token_access_type=offline）で
#    リフレッシュトークンを取得する
#    参考: https://developers.dropbox.com/oauth-guide
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=

# ------------------------------------------------------------
# 【暫定】アクセストークン直指定方式
# ------------------------------------------------------------
# 上記のリフレッシュトークン用の変数が未設定の場合、こちらが使われます。
# Dropbox App Console の「Generated access token」から即時発行できますが、
# 数時間で失効するため検証・開発用途向けです。
DROPBOX_ACCESS_TOKEN=

# ------------------------------------------------------------
# 練習結果PDFが保存されているDropbox内のフォルダパス
# ------------------------------------------------------------
# 例: "/PracticeResults" のようにスラッシュ始まりで指定します。
# Dropboxのルートフォルダを対象にする場合は空のままか "/" を指定してください。
DROPBOX_FOLDER_PATH=/PracticeResults
