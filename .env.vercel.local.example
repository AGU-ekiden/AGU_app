# scripts/setup_vercel.py が読み込む秘密値のテンプレート。
# コピーして .env.vercel.local を作り、値を埋めてください。
# .env.vercel.local は .gitignore 済みでコミットされません。
#
#   cp .env.vercel.local.example .env.vercel.local
#
# 値が空/未記入のキーはスクリプトが自動的にスキップし、実行後に一覧表示します。
# 後からVercelダッシュボード側で手動追加してもOKです。

# --- ryouhi(寮費・食費清算)。任意。未設定ならダミーデータで動作 ---
VITE_GAS_API_URL=
VITE_USE_DUMMY_DATA=

# --- tiryou-karte(メディカルカルテ) ---
NOTION_TOKEN=
NOTION_MEMBERS_DATABASE_ID=
NOTION_MEDICAL_KARTE_DATABASE_ID=
NOTION_RACE_RESULTS_DATABASE_ID=
NOTION_PERSONAL_KARTE_DATABASE_ID=
NOTION_BLOOD_TEST_DATABASE_ID=
NOTION_PLAYER_PROFILE_DATABASE_ID=
NOTION_INBODY_DATABASE_ID=

# --- itonomaki(トレーナー知見ライブラリ)。すべて任意 ---
SITE_USER=
SITE_PASSWORD=
EDIT_PASSWORD=
GITHUB_TOKEN=
FTP_HOST=
FTP_USER=
FTP_PASSWORD=
STRETCH_AUDIO_TOKEN=

# --- spm-medical-record(フィジカルカルテ) ---
# NOTION_TOKEN・NOTION_MEDICAL_KARTE_DATABASE_ID・NOTION_BLOOD_TEST_DATABASE_ID
# は tiryou-karte と共通運用なら上の値を再利用してください
NOTION_DATABASE_ID=
