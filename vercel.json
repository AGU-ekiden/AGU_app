{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": true,

  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ],

  "rewrites": [
    { "source": "/tokei/", "destination": "https://agu-tokei-murex.vercel.app/index.html" },
    { "source": "/tokei/:path+", "destination": "https://agu-tokei-murex.vercel.app/:path+" },

    { "source": "/stopwatch/", "destination": "https://agu-stopwatch-two.vercel.app/index.html" },
    { "source": "/stopwatch/:path+", "destination": "https://agu-stopwatch-two.vercel.app/:path+" },

    { "source": "/taskkyoyu/", "destination": "https://agu-taskkyoyu-gamma.vercel.app/index.html" },
    { "source": "/taskkyoyu/:path+", "destination": "https://agu-taskkyoyu-gamma.vercel.app/:path+" },

    { "source": "/meal_traker/", "destination": "https://agu-meal-traker-two.vercel.app/index.html" },
    { "source": "/meal_traker/:path+", "destination": "https://agu-meal-traker-two.vercel.app/:path+" },

    { "source": "/ryouhi/", "destination": "https://agu-ryouhi-seven.vercel.app/index.html" },
    { "source": "/ryouhi/:path+", "destination": "https://agu-ryouhi-seven.vercel.app/:path+" },

    { "source": "/label_create/", "destination": "https://agu-label-create-gold.vercel.app/index.html" },
    { "source": "/label_create/:path+", "destination": "https://agu-label-create-gold.vercel.app/:path+" },

    { "source": "/tiryou-karte/", "destination": "https://agu-tiryou-karte-delta.vercel.app/tiryou-karte/" },
    { "source": "/tiryou-karte/:path+", "destination": "https://agu-tiryou-karte-delta.vercel.app/tiryou-karte/:path+" },

    { "source": "/spm-medical-record/", "destination": "https://agu-spm-medical-record-nine.vercel.app/spm-medical-record/" },
    { "source": "/spm-medical-record/:path+", "destination": "https://agu-spm-medical-record-nine.vercel.app/spm-medical-record/:path+" },

    { "source": "/itonomaki/", "destination": "https://agu-itonomaki.vercel.app/itonomaki/" },
    { "source": "/itonomaki/:path+", "destination": "https://agu-itonomaki.vercel.app/itonomaki/:path+" }
  ]
}
