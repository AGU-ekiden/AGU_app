{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": true,

  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ],

  "rewrites": [
    { "source": "/tokei/", "destination": "https://agu-tokei-murex.vercel.app/" },
    { "source": "/tokei/(.*)", "destination": "https://agu-tokei-murex.vercel.app/$1" },

    { "source": "/stopwatch/", "destination": "https://agu-stopwatch-two.vercel.app/" },
    { "source": "/stopwatch/(.*)", "destination": "https://agu-stopwatch-two.vercel.app/$1" },

    { "source": "/taskkyoyu/", "destination": "https://agu-taskkyoyu-gamma.vercel.app/" },
    { "source": "/taskkyoyu/(.*)", "destination": "https://agu-taskkyoyu-gamma.vercel.app/$1" },

    { "source": "/meal_traker/", "destination": "https://agu-meal-traker-two.vercel.app/" },
    { "source": "/meal_traker/(.*)", "destination": "https://agu-meal-traker-two.vercel.app/$1" },

    { "source": "/ryouhi/", "destination": "https://agu-ryouhi-seven.vercel.app/" },
    { "source": "/ryouhi/(.*)", "destination": "https://agu-ryouhi-seven.vercel.app/$1" },

    { "source": "/label_create/", "destination": "https://agu-label-create-gold.vercel.app/" },
    { "source": "/label_create/(.*)", "destination": "https://agu-label-create-gold.vercel.app/$1" },

    { "source": "/tiryou-karte/", "destination": "https://agu-tiryou-karte-delta.vercel.app/tiryou-karte/" },
    { "source": "/tiryou-karte/(.*)", "destination": "https://agu-tiryou-karte-delta.vercel.app/tiryou-karte/$1" },

    { "source": "/spm-medical-record/", "destination": "https://agu-spm-medical-record-nine.vercel.app/spm-medical-record/" },
    { "source": "/spm-medical-record/(.*)", "destination": "https://agu-spm-medical-record-nine.vercel.app/spm-medical-record/$1" },

    { "source": "/itonomaki/", "destination": "https://agu-itonomaki.vercel.app/itonomaki/" },
    { "source": "/itonomaki/(.*)", "destination": "https://agu-itonomaki.vercel.app/itonomaki/$1" },

    { "source": "/keihi-seisan/", "destination": "https://agu-keihi-seisan.vercel.app/keihi-seisan/" },
    { "source": "/keihi-seisan/(.*)", "destination": "https://agu-keihi-seisan.vercel.app/keihi-seisan/$1" },

    { "source": "/training-result/", "destination": "https://traininng-result-three.vercel.app/training-result/" },
    { "source": "/training-result/(.*)", "destination": "https://traininng-result-three.vercel.app/training-result/$1" }
  ]
}
